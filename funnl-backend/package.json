{
  "name": "funnl-backend",
  "version": "1.0.0",
  "main": "build/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node build/src/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && chmod 755 build/mcpClient.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test-daily": "jest tests/daily.test.js",
    "assistant": "node build/mcpClient.js ../mcp-server/mcp_server.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hubspot/api-client": "^12.1.0",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@supabase/supabase-js": "^2.49.4",
    "@types/jsonwebtoken": "^9.0.9",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "form-data": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.96.0",
    "tmp": "^0.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "verbose": true
  }
}
